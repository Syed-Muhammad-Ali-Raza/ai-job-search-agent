# Shared
MONGODB_URI=mongodb://localhost:27017/career-copilot
REDIS_URL=redis://localhost:6399
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Service URLs (gateway proxies to these)
AUTH_SERVICE_URL=http://localhost:4001
PROFILE_SERVICE_URL=http://localhost:4002
JOB_SERVICE_URL=http://localhost:4003
AGENT_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005

# Gateway
GATEWAY_PORT=4000
CORS_ORIGIN=http://localhost:5173

# Auth
AUTH_PORT=4001

# Profile
PROFILE_PORT=4002

# Job service — Remotive needs no key; Adzuna is optional
JOB_PORT=4003
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us

# Agent — free LLM via Groq (https://console.groq.com)
AGENT_PORT=4004
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# Notification
NOTIFICATION_PORT=4005
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Career Copilot <noreply@careercopilot.local>
